# Chiavi dei servizi AI. Di solito non serve toccare questo file: le chiavi si inseriscono in
# Impostazioni → Intelligenza artificiale → Servizi e chiavi, e il CRM le salva in .env.local.
# In alternativa copia questo file in .env.local e scrivile qui (valgono subito, senza riavviare).
# Le legge solo il server del CRM: non finiscono nel codice dell'app, nei dati o nei backup.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Unsloth Studio: chiave creata in Settings → API (sk-unsloth-...)
UNSLOTH_API_KEY=

# LM Studio: serve solo se hai attivato l'autenticazione del server
LMSTUDIO_API_KEY=
